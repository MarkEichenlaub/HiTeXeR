// misc: interp, bounds, extension, buildcycle, unit, constants
write(interp(1, 5, 0.5));
write(interp((0,0), (4,2), 0.25));
write(interp((0,0), (4,2), 1.5));
write(extension((0,0), (4,4), (0,4), (4,0)));
write(extension((0,0), (1,2), (5,0), (5,1)));
write(extension((1,1), (2,3), (0,5), (4,1)));
path cyc = buildcycle((0,0)--(3,0), (3,-1)--(3,3), (4,2)--(-1,2), (0,3)--(0,-1));
write(length(cyc));
write(point(cyc, 0));
write(point(cyc, 1));
write(point(cyc, 2));
write(point(cyc, 3));
path cyc2 = buildcycle((0,0)--(4,0), (4,0)..(2,2)..(0,0));
write(length(cyc2));
write(point(cyc2, 0));
write(point(cyc2, 1.5));
write(unit((3,4)));
write(unit((0,-2)));
write(abs(unit((1,1))));
write(point(box((0,0),(2,3)), 2));
write(min(box((1,1),(0,-2))));
write(max(box((1,1),(0,-2))));
write(length(box((0,0),(1,1))));
write(min((0,0)--(1,5)--(-2,3)));
write(max((0,0)--(1,5)--(-2,3)));
write(min((0,0)..(1,1)..(2,0)));
write(max((0,0)..(1,1)..(2,0)));
write(min(unitcircle));
write(max(circle((2,3), 1)));
write(max((0,0){up}..(1,0)));
write(dir(0) + dir(90));
write(N);
write(S);
write(E);
write(W);
write(NE);
write(SW);
write(ENE);
write(NNW);
write(up);
write(down);
write(left);
write(right);
//ASYERR write(origin);
write(realEpsilon > 0);
write(realMax > 1e300);
write(intMax);
write(pi == acos(-1));
write(inch);
write(cm);
write(mm);
write(pt);
write(bp);
write(2cm);
write(1inch/2);
write(dotfactor);
write(arrowlength);
write(arrowangle);
//ASYERR write(arrowsize);
write(Sin(30) + Cos(60));
write(abs(dir(37)));
write(relpoint((0,0)--(10,0), 0.3));
write(arclength((0,0)--(3,0)--(3,4)));
write(conj(dir(30)));
write(rotate(90)*E);
write(angle(dir(135)));
write(degrees(dir(135)));
write(degrees(dir(-135)));
write(degrees(rotate(200)*E));
write(aTan(1) + aSin(1));
write(infinity > 1e100);
write(labelmargin);
write(legendmargin);
write(fontsize(currentpen));
write(sqrt(3)/2 == Sin(60));
write(dir(45) == (sqrt(2)/2, sqrt(2)/2));
write(abs(dir(45) - (sqrt(2)/2, sqrt(2)/2)) < 1e-15);
